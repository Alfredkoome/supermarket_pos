# Database configuration
DB_HOST=localhost
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_DATABASE=supermarket_pos
DB_PORT=3306

# Central automatic MySQL backups. Set BACKUP_DIR to the full path of an existing folder.
# Folder paths with spaces are supported. The backend will not create a folder.
BACKUP_DIR=C:\song\kephas\pos\backend\pos_backup
BACKUP_SCHEDULE_TIME=23:00
BACKUP_TIMEZONE=Africa/Nairobi
# Leave empty to use the MySQL Server 8.0 default path or mysqldump on PATH.
MYSQLDUMP_PATH=

# Session configuration
SESSION_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
SESSION_COOKIE_SECURE=false
SESSION_MAX_AGE_MS=43200000

# M-PESA Daraja configuration
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_SHORTCODE=your_shortcode
MPESA_PASSKEY=your_passkey
MPESA_CALLBACK_URL=your_callback_url
